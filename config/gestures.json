{
  "_comment": "Fire-once poses plus swipes. '1 finger, held' and '2 fingers, swept' are structural - not in this dict, not rebindable, see assistant/vision/gestures.py. '5 fingers' is the ONLY neutral pose: it fires nothing and re-arms the recogniser so a gesture can repeat.",
  "camera_index": 0,
  "fps_limit": 15,
  "hold_frames": 5,
  "cooldown_seconds": 1.0,
  "swipe_travel": 0.22,
  "confidence": 0.5,
  "start_with_app": false,
  "bindings": {
    "fist": {
      "action": "hotkey",
      "keys": "ctrl+windows+f4",
      "label": "close this desktop"
    },
    "three": {
      "action": "hotkey",
      "keys": "volume up",
      "label": "volume up"
    },
    "four": {
      "action": "hotkey",
      "keys": "volume down",
      "label": "volume down"
    },
    "five": {
      "action": "none",
      "label": "(neutral - re-arms, fires nothing)"
    },
    "rock": {
      "action": "hotkey",
      "keys": "windows+shift+s",
      "label": "screenshot"
    },
    "swipe_left": {
      "action": "hotkey",
      "keys": "ctrl+windows+left",
      "label": "previous desktop"
    },
    "swipe_right": {
      "action": "hotkey",
      "keys": "ctrl+windows+right",
      "label": "next desktop"
    },
    "swipe_up": {
      "action": "hotkey",
      "keys": "ctrl+windows+d",
      "label": "new desktop"
    },
    "swipe_down": {
      "action": "hotkey",
      "keys": "windows+m",
      "label": "minimise everything"
    }
  }
}
