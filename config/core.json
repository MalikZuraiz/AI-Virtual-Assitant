{
  "_comment": "Broadest shared settings. Other config files' entries are created inside these defaults.",
  "assistant_name": "Nova",
  "defaults": {
    "workspace_root": "D:/",
    "office_root": "D:/Office",
    "entertainment_root": "D:/Entertainment",
    "flutter_projects_dir": "D:/Office/Projects/Flutter",
    "python_projects_dir": "D:/Office/Projects/Python",
    "scripts_dir": "D:/Office/Scripts",
    "reports_root": "D:/Office/Reports",
    "data_dir": "D:/Office/PED DATA EXTRACTIONS",
    "documents_dir": "D:/Office/Documents",
    "downloads_dir": "C:/Users/Windows/Downloads",
    "wordpress_projects_dir": "D:/Office/Projects/WordPress"
  },
  "day_folder": {
    "_comment": "Tokens: {d} {dd} {month} {mon} {m} {mm} {yyyy} {yy} {weekday}",
    "format": "{d} {month}"
  },
  "browsers": {
    "default": "chrome",
    "known": {
      "chrome": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "edge": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "firefox": "C:\\Program Files\\Mozilla Firefox\\firefox.exe",
      "brave": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      "opera": "C:\\Users\\Windows\\AppData\\Local\\Programs\\Opera\\opera.exe"
    }
  },
  "behaviour": {
    "speak_replies": true,
    "confirm_destructive": true,
    "fuzzy_match_threshold": 82,
    "show_terminals": true
  },
  "llm": {
    "_comment": "Optional local-only fallback for open chat (never for actions). Install Ollama, pull a small quantised model, flip enabled to true, then say 'refresh'. Leave off until you have the RAM headroom.",
    "enabled": true,
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "qwen2.5:1.5b-instruct",
    "prefix": "nova",
    "history_turns": 6
  },
  "last_active_path": "D:/Entertainment/Movies/Interstellar (2014) (2014) [1080p]"
}
